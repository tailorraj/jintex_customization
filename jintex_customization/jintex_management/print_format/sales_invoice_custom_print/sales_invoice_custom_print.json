 "css": ".Invoice-Heading{\n    font-size:13px;\n}\n.Item-Table{\n    margin-top:30px;\n}\n.table-bordered{\n    border:1px solid black!important;\n    font-size:inherit;\n    width:100%;\n}",
 "custom_format": 1,
 "default_print_language": "en-US",
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font": "Default",
 "html": "<div class=\"Invoice-Heading row\">\n    <div class=\"col-xs-6\">\n        <div class=\"col-xs-5\">\n            <label>Bill To:</label>\n            <label>Voucher No:</label>\n        </div>\n        <div class=\"col-xs-7\">\n            <label>{{doc.customer}}</label>\n            <label>{{doc.name}}</label>\n        </div>\n    </div>\n    <div class=\"col-xs-6\">\n        <div class=\"col-xs-5\">\n            <label>Date:</label>\n            <label>Prepared By:</label>\n        </div>\n        <div class=\"col-xs-7\">\n            <label>{{frappe.format(doc.posting_date,{'fieldtype':'Date'})}}</label>\n            {%- for row in doc.sales_team -%}\n            <label>{{ row.sales_person }}</label>\n            {% endfor %}\n        </div>\n    </div>\n    \n</div>\n\n<div class=\"Item-Table\">\n    <table class=\"table-bordered\">\n        <thead>\n            \n            <tr>\n                <th>Sr No</th>\n                <th>Part Image</th>\n                <th>Item Group</th>\n                <th>Particulars</th>\n                <th>Qty</th>\n                <th>Rate</th>\n                <th>Amount</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items %}\n            <tr>\n                <td>{{loop.index}}</td>\n                <td><img src =\"{{item.image}}\" width=\"75\" height=\"50\"></td>\n                <td style=\"white-space:nowrap;\">{{item.item_group}}</td>\n                <td>{{item.item_name}}</td>\n                <td style=\"white-space:nowrap;font-size:14px;\">{{item.qty|int}} {{item.uom}}</td>\n                <td style=\"white-space:nowrap;\">{{frappe.format(item.rate,{'fieldtype':'Currency'})}}</td>\n                <td style=\"white-space:nowrap;\">{{frappe.format(item.amount,{'fieldtype':'Currency'})}}</td>\n            </tr>\n            {% endfor %}\n            <tr>\n                <td></td>\n                <td></td>\n                <td></td>\n                <td class=\"text-right\">Total Qty:</td>\n                <td style=\"white-space:nowrap;\">{{doc.total_qty}}</td>\n                <td style=\"white-space:nowrap;\">Net Total</td>\n                <td style=\"white-space:nowrap;\">{{frappe.format(doc.total,{'fieldtype':'Currency'})}}</td>\n            </tr>\n        </tbody>\n    </table>\n</div>\n\n<div class=\"row\" style=\"margin-top:30px;\">\n    <div class=\"col-xs-12\">\n        <table class=\"table-bordered\">\n            <tbody>\n                <tr>\n                    <td>Remarks:</td>\n                    <td>{{doc.remarks}}</td>\n                    \n                </tr>\n            </tbody>\n        </table>\n    </div>\n</div>\n\n<!--<div class=\"row\" style=\"margin-top:30px;\">-->\n<!--    <div class=\"col-xs-12\">-->\n<!--        <table class=\"table-bordered\">-->\n<!--            <thead>-->\n<!--                <tr>-->\n<!--                    <th>Sr No</th>-->\n<!--                    <th>Item Group</th>-->\n<!--                    <th>Total Qty</th>-->\n<!--                    <th>Total Amount</th>-->\n<!--                </tr>-->\n<!--            </thead>-->\n<!--            <tbody>-->\n<!--                {% for row in doc.calculation_of_item_group_%}-->\n<!--                <tr>-->\n<!--                    <td>{{loop.index}}</td>-->\n<!--                    <td>{{row.item_group}}</td>-->\n<!--                    <td>{{row.total_quantity}}</td>-->\n<!--                    <td>{{row.total_amount}}</td>-->\n<!--                </tr>-->\n<!--                {% endfor %}-->\n<!--            </tbody>-->\n<!--        </table>-->\n<!--    </div>-->\n<!--</div>-->",
